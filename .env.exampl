# The environment variables module 6 reads (Section 11.1). The Python code reads os.environ only, never a file.
# On the server, docker compose (milestone M0) turns a .env next to it into environment variables; .env is in
# .gitignore and must never be committed. Locally, set them in the shell instead:  set GROQ_API_KEY=...
# Never write a real key into this file, the code, a chat or an issue.

# --- providers -------------------------------------------------------------------------------
TTS_PROVIDER=groq                      # groq | fake
STT_PROVIDER=groq                      # groq | fake
TTS_MODEL=canopylabs/orpheus-arabic-saudi
TTS_MODEL_EN=canopylabs/orpheus-v1-english
STT_MODEL=whisper-large-v3
GROQ_API_KEY=                          # secret: environment only
LLM_MODEL_LARGE=
LLM_MODEL_VISION=

# --- storage ---------------------------------------------------------------------------------
BLOB_BACKEND=local
BLOB_DIR=./data/blobs

# --- behavior --------------------------------------------------------------------------------
SCENE_CONCURRENCY=4
TTS_CONCURRENCY=4
MAX_STAGE_ATTEMPTS=3
MAX_SCENE_REPAIRS=2
NARRATOR_GENDER=f
DISPLAY_DIGITS=western                 # western | arabic_indic
SPEECH_WPS_AR=2.4
SPEECH_WPS_EN=2.7
PUBLIC_BASE_URL=

# --- publish and review (S12, Section 10) -------------------------------------------------------
WEBHOOK_SECRET=                        # secret: environment only; signs webhook bodies
REVISION_BATCH_WINDOW_SEC=30
REVISION_REQUIRES_APPROVAL=false
